<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:p1="clr-namespace:AllenNeuralDynamics.Core;assembly=AllenNeuralDynamics.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:p2="clr-namespace:AllenNeuralDynamics.Cuttlefish;assembly=AllenNeuralDynamics.Cuttlefish"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="rx:Defer">
        <Name>Logging</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="PropertySource" TypeArguments="p1:AppendModalitySuffix,sys:Nullable(p1:Modality)">
              <MemberName>Modality</MemberName>
              <Value>Fib</Value>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>Modality</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>0</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraSettingsPath</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="SourcePath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Name" DisplayName="SubjectName" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>LoggingRootPath</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Modality</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Modality" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:AppendModalitySuffix">
                <p1:Modality>Fib</p1:Modality>
              </Combinator>
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0}/camera_settings.xml</Format>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="DestinationPath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:FileCopy">
                <p1:SourcePath>C:/git/Aind.Physiology.Hsfp/local/HSFP-default-camera-config.xml</p1:SourcePath>
                <p1:DestinationPath>C:\output_data\000000_2026-11-17_15-06-39_68b236cd52824716a6c9899d7142e2f6\fib\segment_0001\fib/camera_settings.xml</p1:DestinationPath>
                <p1:Overwrite>false</p1:Overwrite>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CuttlefishEvents</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>Modality</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="Modality" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:GetDeviceMetadata" />
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="DeviceMetadata" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="AllenNeuralDynamics.HarpUtils:LogHarpDeviceWithMetadata.bonsai">
              <DeviceMetadata>%YAML 1.1
---
# yaml-language-server: $schema=https://harp-tech.org/draft-02/schema/device.json
device: Cuttlefish
whoAmI: 1403
firmwareVersion: "0.1"
hardwareTargets: "0.0"
registers:
  PinDirection: &amp;IORegister
    address: 32
    type: U8
    access: Write
    maskType: Pins
    description: "Set the direction of the pins. 0 = input; 1 = output"
  PinState:
    &lt;&lt;: *IORegister
    address: 33
    description: "Read or write the state of the pins."
  PinSet:
    &lt;&lt;: *IORegister
    address: 34
    description: "Set pins specified in the mask to logic HIGH by setting the
                  corresponding bit."
  PinClear:
    &lt;&lt;: *IORegister
    address: 35
    description: "Set specified pins in the mask to logic LOW by setting the
                  corresponding bit."
  EnableRisingEdgeEvents:
    &lt;&lt;: *IORegister
    address: 36
    description: "Enable Events from the RisingEdgeEvents register for the
                  specified pins in the mask when any of the corresponding
                  pins transitions from logic LOW to logic HIGH."
  RisingEdgeEvents:
    &lt;&lt;: *IORegister
    address: 37
    access: Event
    description: "Event Only. Returns a timestamped message with the Port state
                  when any of the pins specified in the EnableRisingEdgeEvents
                  register transitions from logic LOW to logic HIGH."
  EnableFallingEdgeEvents:
    &lt;&lt;: *IORegister
    address: 38
    description: "Enable Events from the FallingEdgeEvents register for the
                  specified pins in the mask when any of the corresponding
                  pins transitions from logic HIGH to logic LOW."
  FallingEdgeEvents:
    &lt;&lt;: *IORegister
    address: 39
    access: Event
    description: "Event Only. Returns a timestamped message with the Port state
                  when any of the pins specified in the EnableFallingEdgeEvents
                  register transitions from logic HIGH to logic LOW."
  PwmState:
    address: 40
    access: [Write, Event]
    type: U8
    maskType: EnableFlag
    description: "Write a nonzero value to this register to start the PWM
                  schedule. Write zero to stop the schedule. Receive an
                  event with payload=0 when the pwm schedule has finished."
  PwmSettings0: &amp;PwmSettingsRegister
    address: 41
    type: U8
    access: Write
    length: 17
    description: "Configure the settings of the PWM output on pin 0."
    interfaceType: PwmSettingsPayload
    payloadSpec:
      OffsetUs:
        offset: 0
        length: 4
        interfaceType: uint
        description: "How long (in microseconds) the output remains LOW before
                      switching HIGH in one period."
      OnDurationUs:
        offset: 4
        length: 4
        interfaceType: uint
        description: "How long (in microseconds) the output remains HIGH in one
                      period."
      OffDurationUs:
        offset: 8
        length: 4
        interfaceType: uint
        description: "How long (in microseconds) the output remains LOW in one
                      period."
      Cycles:
        offset: 12
        length: 4
        interfaceType: uint
        description: "How many pulses to produce, or zero to pulse until
                      disabled."
      Invert:
        offset: 16
        interfaceType: bool
        description: "Whether the output is inverted (on-time refers to the
                      output being LOW instead)."
  PwmSettings1:
    &lt;&lt;: *PwmSettingsRegister
    address: 42
    description: "Configure the settings of the PWM output on pin 1."
  PwmSettings2:
    &lt;&lt;: *PwmSettingsRegister
    address: 43
    description: "Configure the settings of the PWM output on pin 2."
  PwmSettings3:
    &lt;&lt;: *PwmSettingsRegister
    address: 44
    description: "Configure the settings of the PWM output on pin 3."
  PwmSettings4:
    &lt;&lt;: *PwmSettingsRegister
    address: 45
    description: "Configure the settings of the PWM output on pin 4."
  PwmSettings5:
    &lt;&lt;: *PwmSettingsRegister
    address: 46
    description: "Configure the settings of the PWM output on pin 5."
  PwmSettings6:
    &lt;&lt;: *PwmSettingsRegister
    address: 47
    description: "Configure the settings of the PWM output on pin 6."
  PwmSettings7:
    &lt;&lt;: *PwmSettingsRegister
    address: 48
    description: "Configure the settings of the PWM output on pin 7."
  ScheduleStatus:
    address: 49
    access: Event
    type: U8
    description: "Event Only. Emitted when the PWM schedule encounters an
                  error while running. A value of 1 indicates a missed
                  deadline, after which the schedule is aborted."

bitMasks:
  Pins:
    description: "Available pins on the device"
    bits:
      None: 0x0
      Pin0: 0x1
      Pin1: 0x2
      Pin2: 0x4
      Pin3: 0x8
      Pin4: 0x10
      Pin5: 0x20
      Pin6: 0x40
      Pin7: 0x80
</DeviceMetadata>
              <Modality>Fib</Modality>
              <DeviceName>Cuttlefish</DeviceName>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>FrameStreams</Name>
            </Expression>
            <Expression xsi:type="IncludeWorkflow" Path="Extensions\LogHsfpFrameStream.bonsai" />
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Merge" />
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="3" To="13" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="5" To="13" Label="Source2" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="10" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
            <Edge From="9" To="10" Label="Source2" />
            <Edge From="10" To="11" Label="Source1" />
            <Edge From="11" To="12" Label="Source1" />
            <Edge From="12" To="13" Label="Source3" />
            <Edge From="14" To="19" Label="Source1" />
            <Edge From="15" To="16" Label="Source1" />
            <Edge From="16" To="19" Label="Source2" />
            <Edge From="17" To="18" Label="Source1" />
            <Edge From="18" To="19" Label="Source3" />
            <Edge From="20" To="21" Label="Source1" />
            <Edge From="21" To="22" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="WorkflowOutput" />
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>