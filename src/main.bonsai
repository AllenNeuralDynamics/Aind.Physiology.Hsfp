<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:;assembly=Extensions"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:sys="clr-namespace:System;assembly=mscorlib"
                 xmlns:p2="clr-namespace:AllenNeuralDynamics.HamamatsuCamera;assembly=AllenNeuralDynamics.HamamatsuCamera"
                 xmlns:p3="clr-namespace:AllenNeuralDynamics.HamamatsuCamera.Nodes;assembly=AllenNeuralDynamics.HamamatsuCamera"
                 xmlns:p4="clr-namespace:AllenNeuralDynamics.Cuttlefish;assembly=AllenNeuralDynamics.Cuttlefish"
                 xmlns:harp="clr-namespace:Bonsai.Harp;assembly=Bonsai.Harp"
                 xmlns:p5="clr-namespace:AllenNeuralDynamics.Core;assembly=AllenNeuralDynamics.Core"
                 xmlns:p6="clr-namespace:System.Reactive;assembly=System.Reactive.Core"
                 xmlns:ui="clr-namespace:Bonsai.Design;assembly=Bonsai.Design"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="Subject" />
        <Property Name="ChunkSize" />
        <Property Name="ChannelCount" />
        <Property Name="AcquisitionRoot" />
        <Property Name="SegmentId" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Init</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Subject" />
              <Property Name="AcquisitionRoot" />
              <Property Name="SegmentId" />
            </Expression>
            <Expression xsi:type="GroupWorkflow">
              <Name>Registered recording root</Name>
              <Workflow>
                <Nodes>
                  <Expression xsi:type="ExternalizedMapping">
                    <Property Name="Subject" />
                    <Property Name="AcquisitionRoot" />
                    <Property Name="SegmentId" />
                  </Expression>
                  <Expression xsi:type="Combinator">
                    <Combinator xsi:type="p1:HsfpRootPath">
                      <p1:Subject>000000</p1:Subject>
                    </Combinator>
                  </Expression>
                  <Expression xsi:type="rx:AsyncSubject">
                    <Name>LoggingRootPath</Name>
                  </Expression>
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="ChannelCount" />
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="IntProperty">
                <Value>5</Value>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>ChannelCount</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="ChunkSize" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p1:TiffWriter,sys:Nullable(sys:Int32)">
              <MemberName>ChunkSize</MemberName>
              <Value>1000</Value>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>TiffChunkSize</Name>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="3" To="4" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
            <Edge From="6" To="7" Label="Source1" />
            <Edge From="7" To="8" Label="Source1" />
            <Edge From="8" To="9" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="ExternalizedMapping">
        <Property Name="SettingsPath" />
        <Property Name="LookupTablePath" />
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>Camera</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="SettingsPath" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:C13440,sys:String">
              <MemberName>SettingsPath</MemberName>
              <Value>C:/git/Aind.Physiology.Hsfp/local/HSFP-default-camera-config.xml</Value>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>CameraSettingsPath</Name>
            </Expression>
            <Expression xsi:type="ExternalizedMapping">
              <Property Name="Value" DisplayName="LookupTablePath" />
            </Expression>
            <Expression xsi:type="PropertySource" TypeArguments="p2:C13440,sys:String">
              <MemberName>LookupTablePath</MemberName>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Take">
                <rx:Count>1</rx:Count>
              </Combinator>
            </Expression>
            <Expression xsi:type="rx:AsyncSubject">
              <Name>CameraLutPath</Name>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraSettingsPath</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="SettingsPath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CameraLutPath</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="LookupTablePath" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p1:HsfpCamera">
                <p1:Regions>
                  <p1:RegionOfInterest>
                    <p1:X>63</p1:X>
                    <p1:Y>881</p1:Y>
                    <p1:Width>1976</p1:Width>
                    <p1:Height>236</p1:Height>
                  </p1:RegionOfInterest>
                </p1:Regions>
                <p1:CropMode>Auto</p1:CropMode>
                <p1:EnableBundling>false</p1:EnableBundling>
                <p1:BundleSize>1</p1:BundleSize>
                <p1:SettingsPath>C:/git/Aind.Physiology.Hsfp/local/HSFP-default-camera-config.xml</p1:SettingsPath>
                <p1:DeviceName>Hamamatsu Orca Flash 4 v3</p1:DeviceName>
              </Combinator>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p3:Frames" />
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>CuttlefishEvents</Name>
            </Expression>
            <Expression xsi:type="p4:Parse">
              <harp:Register xsi:type="p4:TimestampedRisingEdgeEvents" />
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Value</Selector>
            </Expression>
            <Expression xsi:type="MemberSelector">
              <Selector>Seconds</Selector>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="rx:Condition">
              <Workflow>
                <Nodes>
                  <Expression xsi:type="WorkflowInput">
                    <Name>Source1</Name>
                  </Expression>
                  <Expression xsi:type="MemberSelector">
                    <Selector>Item1</Selector>
                  </Expression>
                  <Expression xsi:type="HasFlag">
                    <Operand xsi:type="WorkflowProperty" TypeArguments="p4:Pins">
                      <Value>Pin1 Pin2 Pin3 Pin4 Pin5 Pin6 Pin7</Value>
                    </Operand>
                  </Expression>
                  <Expression xsi:type="WorkflowOutput" />
                </Nodes>
                <Edges>
                  <Edge From="0" To="1" Label="Source1" />
                  <Edge From="1" To="2" Label="Source1" />
                  <Edge From="2" To="3" Label="Source1" />
                </Edges>
              </Workflow>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Zip" />
            </Expression>
            <Expression xsi:type="rx:GroupBy">
              <rx:KeySelector>Item2.Item1</rx:KeySelector>
              <rx:ElementSelector>Item1,Item2.Item2</rx:ElementSelector>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>ChannelCount</Name>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="BufferSize" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="rx:ReplaySubject">
              <Name>FrameStreams</Name>
              <rx:BufferSize>5</rx:BufferSize>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:Processing">
                <p2:DeinterleaveCount>5</p2:DeinterleaveCount>
              </Combinator>
            </Expression>
            <Expression xsi:type="SubscribeSubject">
              <Name>LoggingRootPath</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p5:AppendModalitySuffix">
                <p5:Modality>Fib</p5:Modality>
              </Combinator>
            </Expression>
            <Expression xsi:type="Format">
              <Format>{0}/session_params_.csv</Format>
              <Selector>it</Selector>
            </Expression>
            <Expression xsi:type="PropertyMapping">
              <PropertyMappings>
                <Property Name="FileName" />
              </PropertyMappings>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="p2:CsvWriter">
                <p2:FileName>C:\output_data\000000_2026-11-17_15-06-39_68b236cd52824716a6c9899d7142e2f6\fib\segment_0001\fib/session_params_.csv</p2:FileName>
                <p2:Suffix>Timestamp</p2:Suffix>
                <p2:Overwrite>false</p2:Overwrite>
              </Combinator>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
            <Edge From="2" To="3" Label="Source1" />
            <Edge From="4" To="5" Label="Source1" />
