{
  "$defs": {
    "AindPhysioHsfpRig": {
      "description": "Complete rig configuration model for the AIND HSFP system.",
      "properties": {
        "aind_behavior_services_pkg_version": {
          "default": "0.13.9",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "title": "aind_behavior_services package version",
          "type": "string"
        },
        "version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "computer_name": {
          "description": "Computer name",
          "title": "Computer Name",
          "type": "string"
        },
        "rig_name": {
          "description": "Rig name",
          "title": "Rig Name",
          "type": "string"
        },
        "data_directory": {
          "description": "Directory where data will be saved to",
          "format": "path",
          "title": "Data Directory",
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/HsfpCamera",
          "description": "Camera that records the dispersed fiber output.",
          "title": "Camera"
        },
        "cuttlefish": {
          "$ref": "#/$defs/HarpCuttlefish",
          "description": "cuTTLefish board that triggers the camera and the light sources.",
          "title": "cuTTLefish"
        },
        "channels": {
          "$ref": "#/$defs/CuttlefishChannels",
          "default": {
            "channel_1": {
              "name": "OBIS 405 LX",
              "power": null,
              "serial_number": null,
              "wavelength": 405
            },
            "channel_2": {
              "name": "OBIS 445 LX",
              "power": null,
              "serial_number": null,
              "wavelength": 445
            },
            "channel_3": {
              "name": "OBIS 488 LX",
              "power": null,
              "serial_number": null,
              "wavelength": 488
            },
            "channel_4": {
              "name": "OBIS 514 LX",
              "power": null,
              "serial_number": null,
              "wavelength": 514
            },
            "channel_5": {
              "name": "OBIS 561 LS",
              "power": null,
              "serial_number": null,
              "wavelength": 561
            },
            "channel_6": null,
            "channel_7": null
          },
          "description": "Light source on each cuTTLefish channel. Channel 0 triggers the camera. Each light source defines the acquisition channel with the same number.",
          "title": "cuTTLefish channels"
        },
        "timing": {
          "$ref": "#/$defs/TriggerTiming",
          "default": {
            "frame_period_us": 6667,
            "camera_trigger_duration_us": 100,
            "light_source_on_duration_us": 1000,
            "light_source_delay_us": 0
          },
          "description": "Timing of the camera and light source triggers, shared by all light sources.",
          "title": "Trigger timing"
        },
        "tiff_chunk_size": {
          "default": 1000,
          "description": "Number of frames per TIFF file.",
          "exclusiveMinimum": 0,
          "title": "Tiff Chunk Size",
          "type": "integer"
        }
      },
      "required": [
        "computer_name",
        "rig_name",
        "data_directory",
        "camera",
        "cuttlefish"
      ],
      "title": "AindPhysioHsfpRig",
      "type": "object"
    },
    "AindPhysioHsfpTaskLogic": {
      "additionalProperties": false,
      "description": "Task logic for the AIND HSFP system.",
      "properties": {
        "name": {
          "const": "AindPhysioHsfp",
          "default": "AindPhysioHsfp",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Description of the task.",
          "title": "Description",
          "type": "string"
        },
        "task_parameters": {
          "$ref": "#/$defs/AindPhysioHsfpTaskParameters",
          "description": "Parameters of the task"
        },
        "version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Version",
          "type": "string"
        },
        "stage_name": {
          "default": null,
          "description": "Optional stage name the `Task` object instance represents.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stage Name"
        }
      },
      "title": "AindPhysioHsfpTaskLogic",
      "type": "object"
    },
    "AindPhysioHsfpTaskParameters": {
      "additionalProperties": true,
      "description": "Parameters of the HSFP task.",
      "properties": {
        "rng_seed": {
          "default": null,
          "description": "Seed of the random number generator",
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rng Seed"
        },
        "aind_behavior_services_pkg_version": {
          "default": "0.13.9",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "title": "aind_behavior_services package version",
          "type": "string"
        },
        "measurements": {
          "description": "Fibers recorded in the experiment.",
          "items": {
            "$ref": "#/$defs/Measurement"
          },
          "title": "Measurements",
          "type": "array"
        }
      },
      "title": "AindPhysioHsfpTaskParameters",
      "type": "object"
    },
    "BaseModel": {
      "properties": {},
      "title": "BaseModel",
      "type": "object"
    },
    "CameraRegion": {
      "description": "Rectangular region of the camera sensor, defined by its top-left corner, width and height (px).",
      "properties": {
        "x": {
          "default": 0,
          "description": "X coordinate of the top-left corner (px).",
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "description": "Y coordinate of the top-left corner (px).",
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "width": {
          "default": 0,
          "description": "Width of the region (px).",
          "minimum": 0,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 0,
          "description": "Height of the region (px).",
          "minimum": 0,
          "title": "Height",
          "type": "integer"
        }
      },
      "title": "CameraRegion",
      "type": "object"
    },
    "CuttlefishChannels": {
      "description": "Light source triggered by each cuTTLefish channel, or None if the channel is unused.\n\nChannel 0 is reserved for the camera trigger. Light sources fire in channel order, skipping unused channels.",
      "properties": {
        "channel_1": {
          "default": {
            "name": "OBIS 405 LX",
            "wavelength": 405,
            "power": null,
            "serial_number": null
          },
          "description": "Light source on channel 1.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_2": {
          "default": {
            "name": "OBIS 445 LX",
            "wavelength": 445,
            "power": null,
            "serial_number": null
          },
          "description": "Light source on channel 2.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_3": {
          "default": {
            "name": "OBIS 488 LX",
            "wavelength": 488,
            "power": null,
            "serial_number": null
          },
          "description": "Light source on channel 3.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_4": {
          "default": {
            "name": "OBIS 514 LX",
            "wavelength": 514,
            "power": null,
            "serial_number": null
          },
          "description": "Light source on channel 4.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_5": {
          "default": {
            "name": "OBIS 561 LS",
            "wavelength": 561,
            "power": null,
            "serial_number": null
          },
          "description": "Light source on channel 5.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_6": {
          "default": null,
          "description": "Light source on channel 6.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "channel_7": {
          "default": null,
          "description": "Light source on channel 7.",
          "oneOf": [
            {
              "$ref": "#/$defs/LightSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "title": "CuttlefishChannels",
      "type": "object"
    },
    "FiberRoi": {
      "description": "Regions of interest of one fiber: one rectangle of the camera image per acquisition channel.",
      "properties": {
        "fiber_number": {
          "description": "Number of the implanted fiber (Fiber_N in the procedures).",
          "minimum": 0,
          "title": "Fiber Number",
          "type": "integer"
        },
        "regions": {
          "description": "Region of the camera image of this fiber, per acquisition channel (index = channel).",
          "items": {
            "$ref": "#/$defs/CameraRegion"
          },
          "minItems": 1,
          "title": "Regions",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "description": "Whether the fiber is recorded.",
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "fiber_number",
        "regions"
      ],
      "title": "FiberRoi",
      "type": "object"
    },
    "HarpCuttlefish": {
      "properties": {
        "device_type": {
          "const": "cuTTLefish",
          "default": "cuTTLefish",
          "title": "Device Type",
          "type": "string"
        },
        "calibration": {
          "default": null,
          "description": "Calibration for the device.",
          "oneOf": [
            {
              "$ref": "#/$defs/BaseModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "who_am_i": {
          "const": 1403,
          "default": 1403,
          "title": "Who Am I",
          "type": "integer"
        },
        "serial_number": {
          "default": null,
          "description": "Device serial number",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Serial Number"
        },
        "port_name": {
          "description": "Device port name",
          "title": "Port Name",
          "type": "string"
        }
      },
      "required": [
        "port_name"
      ],
      "title": "HarpCuttlefish",
      "type": "object"
    },
    "HsfpCamera": {
      "description": "Hamamatsu camera that images the dispersed fiber output.",
      "properties": {
        "device_type": {
          "const": "HsfpCamera",
          "default": "HsfpCamera",
          "title": "Device Type",
          "type": "string"
        },
        "calibration": {
          "default": null,
          "description": "Calibration for the device.",
          "oneOf": [
            {
              "$ref": "#/$defs/BaseModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "device_name": {
          "default": "Hamamatsu Orca Flash 4 v3",
          "description": "Name of the camera, as it appears in the instrument metadata.",
          "title": "Device Name",
          "type": "string"
        },
        "settings_path": {
          "description": "Path to the Hamamatsu camera settings (.xml) file.",
          "title": "Settings Path",
          "type": "string"
        },
        "lookup_table_path": {
          "default": null,
          "description": "Optional path to a lookup table (.csv) file.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lookup Table Path"
        },
        "region": {
          "$ref": "#/$defs/CameraRegion",
          "default": {
            "x": 63,
            "y": 881,
            "width": 1976,
            "height": 236
          },
          "description": "Region of the sensor that is cropped and recorded (px)."
        }
      },
      "required": [
        "settings_path"
      ],
      "title": "HsfpCamera",
      "type": "object"
    },
    "IntendedMeasurements": {
      "description": "Biological signal measured in each color band of one fiber. A null value means the band is not used.",
      "properties": {
        "blue": {
          "default": null,
          "description": "Intended measurement in the blue band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blue"
        },
        "green": {
          "default": null,
          "description": "Intended measurement in the green band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Green"
        },
        "yellow": {
          "default": null,
          "description": "Intended measurement in the yellow band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Yellow"
        },
        "orange": {
          "default": null,
          "description": "Intended measurement in the orange band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Orange"
        },
        "red": {
          "default": null,
          "description": "Intended measurement in the red band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Red"
        },
        "iso": {
          "default": null,
          "description": "Intended measurement in the isosbestic band.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Iso"
        }
      },
      "title": "IntendedMeasurements",
      "type": "object"
    },
    "LightSource": {
      "description": "A light source triggered by one cuTTLefish channel. Each light source defines one acquisition channel.",
      "properties": {
        "name": {
          "description": "Name of the light source, as it appears in the instrument metadata.",
          "title": "Name",
          "type": "string"
        },
        "wavelength": {
          "default": null,
          "description": "Excitation wavelength (nm), if known.",
          "oneOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wavelength"
        },
        "power": {
          "default": null,
          "description": "Power (uW) at the fiber tip. If not set, it is taken from the instrument.",
          "oneOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Power"
        },
        "serial_number": {
          "default": null,
          "description": "Serial number of the OBIS laser, which is found among the OBIS lasers connected over USB when the workflow starts, and controlled from its tab of the acquisition UI. The wavelength it reports must match wavelength. If not set, the light source is not controlled.",
          "oneOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Serial Number"
        }
      },
      "required": [
        "name"
      ],
      "title": "LightSource",
      "type": "object"
    },
    "Measurement": {
      "description": "A recorded fiber: the implanted fiber and the patch cord connected to it.",
      "properties": {
        "fiber_number": {
          "description": "Number of the implanted fiber (Fiber_N in the procedures).",
          "minimum": 0,
          "title": "Fiber Number",
          "type": "integer"
        },
        "patch_cord": {
          "description": "Index of the patch cord connected to the fiber.",
          "minimum": 0,
          "title": "Patch Cord",
          "type": "integer"
        },
        "intended_measurements": {
          "$ref": "#/$defs/IntendedMeasurements",
          "description": "Intended measurement in each color band."
        },
        "enabled": {
          "default": true,
          "description": "Whether the fiber is recorded.",
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "fiber_number",
        "patch_cord"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "RoiSettings": {
      "description": "Regions of interest used to integrate the fluorescence of each fiber, in each channel.",
      "properties": {
        "rois": {
          "description": "Regions of interest, one entry per fiber.",
          "items": {
            "$ref": "#/$defs/FiberRoi"
          },
          "title": "Rois",
          "type": "array"
        }
      },
      "title": "RoiSettings",
      "type": "object"
    },
    "Session": {
      "properties": {
        "aind_behavior_services_pkg_version": {
          "default": "0.13.9",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
          "title": "aind_behavior_services package version",
          "type": "string"
        },
        "version": {
          "const": "0.13.9",
          "default": "0.13.9",
          "title": "Version",
          "type": "string"
        },
        "experiment": {
          "default": null,
          "description": "Name of the experiment",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Experiment"
        },
        "experimenter": {
          "default": [],
          "description": "Name of the experimenter",
          "items": {
            "type": "string"
          },
          "title": "Experimenter",
          "type": "array"
        },
        "date": {
          "description": "Date of the experiment",
          "format": "date-time",
          "title": "Date",
          "type": "string"
        },
        "session_name": {
          "default": null,
          "description": "Name of the session. This will be used to create a folder in the root path. If not provided, it will be generated using subject and date.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Session Name"
        },
        "subject": {
          "description": "Name of the subject",
          "title": "Subject",
          "type": "string"
        },
        "notes": {
          "default": null,
          "description": "Notes about the experiment",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        },
        "commit_hash": {
          "default": null,
          "description": "Commit hash of the repository",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit Hash"
        },
        "allow_dirty_repo": {
          "default": false,
          "description": "Allow running from a dirty repository",
          "title": "Allow Dirty Repo",
          "type": "boolean"
        },
        "skip_hardware_validation": {
          "default": false,
          "description": "Skip hardware validation",
          "title": "Skip Hardware Validation",
          "type": "boolean"
        }
      },
      "required": [
        "subject"
      ],
      "title": "Session",
      "type": "object"
    },
    "TriggerTiming": {
      "description": "Timing shared by the camera and every light source. All values are integer microseconds, so the PWM outputs\nof the cuTTLefish board are derived exactly, without rounding.\n\nThe camera is triggered once per frame on channel 0. The light sources fire in turn, one per frame, in channel\norder: with L light sources, the k-th one fires in frames k, k + L, k + 2L... so its period is exactly L frame\nperiods.",
      "properties": {
        "frame_period_us": {
          "default": 6667,
          "description": "Time (us) between consecutive camera triggers. The frame rate is 1e6 / frame_period_us, and each light source is sampled at 1e6 / (frame_period_us * number of light sources).",
          "maximum": 1000000,
          "minimum": 10,
          "title": "Frame Period Us",
          "type": "integer"
        },
        "camera_trigger_duration_us": {
          "default": 100,
          "description": "Time (us) the camera trigger stays HIGH in each frame.",
          "minimum": 1,
          "title": "Camera Trigger Duration Us",
          "type": "integer"
        },
        "light_source_on_duration_us": {
          "default": 1000,
          "description": "Time (us) each light source stays on in its frame.",
          "minimum": 1,
          "title": "Light Source On Duration Us",
          "type": "integer"
        },
        "light_source_delay_us": {
          "default": 0,
          "description": "Time (us) from the rising edge of the camera trigger to the light source turning on, in the light source's frame.",
          "minimum": 0,
          "title": "Light Source Delay Us",
          "type": "integer"
        }
      },
      "title": "TriggerTiming",
      "type": "object"
    }
  }
}